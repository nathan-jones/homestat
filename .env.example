# Name of the bridge in the Home app
HOMESTAT_NAME=Homestat
# HOMESTAT_PORT=51826           # HomeKit port (change if Homebridge uses 51826)
# HOMESTAT_API_PORT=8080        # web UI
# HOMESTAT_API_ALLOW=192.168.1.10,192.168.1.11   # restrict the web UI/API to these IPs
# HOMESTAT_SAMPLE_INTERVAL=5    # seconds between samples; sparklines show 120 samples

# Home Assistant: Profile → Security → Long-lived access tokens
HOMESTAT_HA_URL=http://homeassistant.local:8123
HOMESTAT_HA_TOKEN=

# Prometheus (or anything with its HTTP API: VictoriaMetrics, Thanos, Mimir)
HOMESTAT_PROMETHEUS_URL=http://prometheus:9090

# MQTT broker
HOMESTAT_MQTT_URL=mqtt://user:password@mqtt.local:1883

# RUST_LOG=homestat=debug
